        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <PropertyGroup>
        <PackageId>AlfaHackaton.Kafka</PackageId>
        <Version>1.1.0</Version>
        <Authors>AlfaHackathon</Authors>
        <Description>Пакет для работы с Kafka</Description>
